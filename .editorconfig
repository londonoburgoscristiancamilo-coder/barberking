# EditorConfig - BarberKing
# Configuración de formato e indentación del proyecto

root = true

# Configuración global
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# PHP y Laravel Blade
[*.{php,blade.php}]
indent_style = space
indent_size = 4

# JavaScript, CSS y HTML
[*.{js,mjs,cjs,css,html}]
indent_style = space
indent_size = 4

# Archivos JSON
[*.json]
indent_style = space
indent_size = 4

# Documentación Markdown
[*.md]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

# Configuración YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Docker Compose
[compose.yaml]
indent_style = space
indent_size = 4

# Dockerfile
[Dockerfile]
indent_style = space
indent_size = 4

# Archivos de shell
[*.{sh,bash}]
indent_style = space
indent_size = 4
